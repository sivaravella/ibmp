{
  "name": "@ibmp/api",
  "version": "1.21.2",
  "description": "IBMP API: Express + PostgreSQL",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "dev:mem": "node scripts/dev-mem.js",
    "migrate": "node scripts/migrate.js",
    "test": "node --test \"test/*.test.js\"",
    "local": "node scripts/run-local.js",
    "seed": "node scripts/seed-demo.js",
    "test:pg": "node scripts/test-pg.js",
    "seed:users": "node scripts/seed-users.js",
    "admin:create": "node scripts/create-platform-admin.js"
  },
  "dependencies": {
