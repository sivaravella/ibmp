    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.0.15",
    "pg": "^8.12.0",
    "puppeteer-core": "^24.43.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "embedded-postgres": "^18.4.0-beta.17",
    "pg-mem": "^3.0.2"
  },
  "engines": {
    "node": ">=20"
