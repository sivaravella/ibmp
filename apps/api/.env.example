# IBMP API configuration. Copy to .env or set these in your hosting environment.
# IBMP_-prefixed names are canonical; the unprefixed ones (DATABASE_URL, PORT, JWT_SECRET, ...) still work as fallbacks.

# --- Core (required in production: the API refuses to start with unsafe values) ---
NODE_ENV=production
IBMP_PORT=4000
IBMP_DATABASE_URL=postgres://ibmp:ibmp@localhost:5432/ibmp
IBMP_DATABASE_SSL=false
IBMP_DB_POOL_MAX=10
# At least 32 random characters:   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
IBMP_JWT_SECRET=
# At least 16 random characters. Encrypts the GST portal session token at rest.
IBMP_SECRETS_KEY=
# Only needed when the web app is hosted on a different origin. Comma-separated, never *.
IBMP_CORS_ORIGINS=
# Set to 1 (or the number of proxy hops) behind a load balancer so rate limits see the real client IP.
IBMP_TRUST_PROXY=
IBMP_RATE_LIMIT=true
IBMP_AUTH_RATE_LIMIT_PER_MIN=20
IBMP_API_RATE_LIMIT_PER_MIN=600
IBMP_BCRYPT_ROUNDS=12
IBMP_LOG_REQUESTS=true
# Directory of the built web app to serve from the same origin (default: apps/web/dist when present).
IBMP_WEB_DIR=
# Lets the SIMULATED payment gateway and GSP run in production mode. Demos only: nothing is really charged or filed.
IBMP_ENABLE_SIMULATORS=false

# --- Payment gateway (Razorpay). Start with TEST keys (rzp_test_...). ---
# Webhook URL for the Razorpay dashboard (events: payment.captured, order.paid, payment.failed):
#   https://<your-host>/v1/webhooks/payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Who issues the subscription invoices (printed on every tax invoice). IBMP_STATE_CODE decides CGST+SGST vs IGST. ---
IBMP_LEGAL_NAME=
IBMP_GSTIN=
IBMP_ADDRESS=
IBMP_STATE_CODE=36
IBMP_INVOICE_PREFIX=IBMP

# --- Back-office key for verifying consultants' credentials. /v1/admin does not exist unless set (min 24 chars in production). ---
# Send it as the x-admin-key header. Keep it out of the browser.
IBMP_ADMIN_API_KEY=

# --- GST Suvidha Provider. Empty = simulated outside production, disabled in production. masters_india / tera are not implemented yet. ---
IBMP_GSP_PROVIDER=

# --- Compliance reminders ---
# The address users open (put in reminder emails).
IBMP_PUBLIC_URL=
# Set to false on all but one instance if you run several and do not want each to run the daily job (it is safe either way:
# a database lock and the message log stop duplicates).
IBMP_REMINDERS_JOB=true
# Email: any SMTP server, e.g. smtps://user:password@smtp.example.com:465
# Brevo: smtp://LOGIN%40smtp-brevo.com:SMTP_KEY@smtp-relay.brevo.com:587 (write the @ in the login as %40). IBMP_MAIL_FROM must be a sender or domain verified in Brevo.
IBMP_SMTP_URL=
IBMP_MAIL_FROM=IBMP <no-reply@your-domain.com>
# WhatsApp Business Cloud API (Meta). The template must be approved in WhatsApp Manager first (category Utility), with a body such as
#   "Compliance reminder for {{1}}: {{2}}. Open IBMP for details."
IBMP_WHATSAPP_TOKEN=
IBMP_WHATSAPP_PHONE_ID=
IBMP_WHATSAPP_TEMPLATE=ibmp_compliance_reminder
IBMP_WHATSAPP_LANG=en

# SMS reminders (Twilio). India requires DLT registration: the SMS text must match a registered template. Register
#   "IBMP reminder: {#var#} has {#var#} compliance item(s) to action. Next: {#var#} due {#var#}. Open IBMP for details."
# (or your own template with up to 4 {#var#} placeholders: company, item count, next item, its due date) and paste the registered text below.
IBMP_TWILIO_ACCOUNT_SID=
IBMP_TWILIO_AUTH_TOKEN=
# A registered sender ID or number, OR a Twilio Messaging Service SID:
IBMP_SMS_FROM=
IBMP_TWILIO_MESSAGING_SERVICE_SID=
IBMP_SMS_TEMPLATE=
IBMP_SMS_VAR_MAX=30

# --- Sign in with Google and LinkedIn (optional: a button appears only when both id and secret are set) ---
# Authorised redirect URIs to register with each provider (replace the host with IBMP_PUBLIC_URL):
#   https://<your-host>/v1/auth/social/google/callback
#   https://<your-host>/v1/auth/social/linkedin/callback
# Google: Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application). Scopes: openid, email, profile.
# LinkedIn: developer portal > create app > Products > "Sign In with LinkedIn using OpenID Connect". Scopes: openid, profile, email.
# Set IBMP_PUBLIC_URL to the address users open (it is used to build the redirect URIs).
IBMP_GOOGLE_CLIENT_ID=
IBMP_GOOGLE_CLIENT_SECRET=
IBMP_LINKEDIN_CLIENT_ID=
IBMP_LINKEDIN_CLIENT_SECRET=
